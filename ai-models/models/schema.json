{
  "target": "price_range",
  "labels": {
    "0": "Low Cost",
    "1": "Medium Cost",
    "2": "High Cost",
    "3": "Very High Cost"
  },
  "features": [
    {"name": "battery_power", "type": "integer", "min": 500,  "max": 2000, "unit": "mAh"},
    {"name": "blue",          "type": "binary",  "min": 0,    "max": 1},
    {"name": "clock_speed",   "type": "float",   "min": 0.5,  "max": 3.0,  "unit": "GHz"},
    {"name": "dual_sim",      "type": "binary",  "min": 0,    "max": 1},
    {"name": "fc",            "type": "integer", "min": 0,    "max": 20,   "unit": "MP"},
    {"name": "four_g",        "type": "binary",  "min": 0,    "max": 1},
    {"name": "int_memory",    "type": "integer", "min": 2,    "max": 64,   "unit": "GB"},
    {"name": "m_dep",         "type": "float",   "min": 0.1,  "max": 1.0,  "unit": "cm"},
    {"name": "mobile_wt",     "type": "integer", "min": 80,   "max": 200,  "unit": "g"},
    {"name": "n_cores",       "type": "integer", "min": 1,    "max": 8},
    {"name": "pc",            "type": "integer", "min": 0,    "max": 20,   "unit": "MP"},
    {"name": "px_height",     "type": "integer", "min": 0,    "max": 1960, "unit": "px"},
    {"name": "px_width",      "type": "integer", "min": 500,  "max": 1998, "unit": "px"},
    {"name": "ram",           "type": "integer", "min": 256,  "max": 4000, "unit": "MB"},
    {"name": "sc_h",          "type": "integer", "min": 5,    "max": 19,   "unit": "cm"},
    {"name": "sc_w",          "type": "integer", "min": 0,    "max": 18,   "unit": "cm"},
    {"name": "talk_time",     "type": "integer", "min": 2,    "max": 20,   "unit": "h"},
    {"name": "three_g",       "type": "binary",  "min": 0,    "max": 1},
    {"name": "touch_screen",  "type": "binary",  "min": 0,    "max": 1},
    {"name": "wifi",          "type": "binary",  "min": 0,    "max": 1}
  ]
}